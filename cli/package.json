{
  "name": "rankdelta",
  "version": "0.1.0",
  "description": "Thin CLI over the hosted Rankdelta MCP server — AI visibility, ranks and page audits from your terminal.",
  "type": "module",
  "bin": {
    "rankdelta": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
