# ── Supabase (required) ──────────────────────────────────────────────
VITE_SUPABASE_URL=
# Accepts either the legacy anon key or a new-style publishable key (`sb_publishable_…`) — both are
# public by design and RLS stays the control plane. Supabase now marks the anon key deprecated.
# NOTE: this is the BROWSER key and takes a bare string. It is NOT the edge-function secret
# SUPABASE_PUBLISHABLE_KEYS, which Supabase injects as a JSON dictionary of keys and which you
# cannot set yourself (the `SUPABASE_` prefix is reserved).
VITE_SUPABASE_ANON_KEY=

# ── LLM + SEO/SERP + citation keys are SERVER-SIDE EDGE SECRETS — never VITE_ vars ──
# These MUST NOT be in the client bundle (VITE_* is shipped to the browser). The seo-proxy Edge
# Function holds them. Set them once with `supabase secrets set` (provide EITHER OpenRouter OR OpenAI):
#   supabase secrets set OPENROUTER_API_KEY=...  --project-ref <ref>   # preferred (cheaper Kimi/Claude)
#   supabase secrets set OPENAI_API_KEY=...       --project-ref <ref>   # fallback
#   supabase secrets set DATAFORSEO_LOGIN=...     --project-ref <ref>   # keyword/SERP/backlink data
#   supabase secrets set DATAFORSEO_PASSWORD=...  --project-ref <ref>
#   supabase secrets set PERPLEXITY_API_KEY=...   --project-ref <ref>   # optional, citation checks
#   supabase secrets set OPENPAGERANK_API_KEY=... --project-ref <ref>   # optional, free authority signal
# Then set VITE_USE_SUPABASE_PROXY=true below. Do NOT put any of these values in this file.

# ── Images (optional — featured + in-article). SERVER-SIDE, never VITE_ ──
#   supabase secrets set PEXELS_API_KEY=... UNSPLASH_ACCESS_KEY=...
# Wikimedia CC0 is used first and needs no key. If these secrets are unset, stock fallbacks are skipped.

# ── Google Search Console (optional — "proof of results": real clicks/impressions/position) ──
# A *public* OAuth Client ID (NOT a secret) for client-side OAuth. Set up once in YOUR Google Cloud:
#   1. APIs & Services → Credentials → Create OAuth Client ID → type "Web application"
#   2. Add your app origin (e.g. http://localhost:5173 + prod URL) to "Authorized JavaScript origins"
#   3. Enable the "Google Search Console API"
# Safe to ship in the bundle; each user authorizes their own Google account (read-only) in-browser.
VITE_GOOGLE_CLIENT_ID=

# ── Production proxy (optional) ──────────────────────────────────────
# Set to "true" AFTER deploying the seo-proxy Edge Function and setting its
# DATAFORSEO_LOGIN / DATAFORSEO_PASSWORD secrets. Routes DataForSEO + sitemap
# calls server-side (fixes browser CORS + keeps credentials off the client).
VITE_USE_SUPABASE_PROXY=false

# Answer receipts modal (Visibility insights, prompts, engine chips). On by default; set false to disable.
# VITE_ENABLE_AI_ANSWER_RECEIPTS=false
