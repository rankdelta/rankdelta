# ── Rankdelta — SELF-HOST (open edition) ───────────────────────────────────────
# The SAME app as the cloud, run on your own infrastructure with your own keys.
# Copy to .env, fill in, and build/run. Nothing here is billed by us — you pay the
# APIs directly (BYOK). See SELF_HOSTING.md.

# Turns off billing / paywall / credits and unlocks every value action (BYOK).
VITE_DEPLOYMENT_MODE=selfhost

# ── Your Supabase (self-hosted) ───────────────────────────────────────────────
# Run Supabase locally with its official docker-compose (postgres + auth + edge
# runtime), then point these at it. See SELF_HOSTING.md, step 1.
VITE_SUPABASE_URL=http://localhost:8000
# Either the legacy anon key or a new-style publishable key (`sb_publishable_…`); both are public
# by design and RLS stays the control plane. This BROWSER key takes a bare string — it is not the
# edge-function secret SUPABASE_PUBLISHABLE_KEYS (a JSON dictionary Supabase injects itself).
VITE_SUPABASE_ANON_KEY=your-self-hosted-anon-key

# Route DataForSEO / sitemap calls through your Supabase edge proxy (avoids browser CORS).
VITE_USE_SUPABASE_PROXY=true

# ── Bring your own API keys (set as edge-function secrets, NOT in this file) ───
# These are consumed server-side by the edge functions on YOUR Supabase. Set them with:
#   supabase secrets set SELF_HOST=true DATAFORSEO_LOGIN=... DATAFORSEO_PASSWORD=... OPENROUTER_API_KEY=...
# They are listed here only so you know what to provide:
#   SELF_HOST=true        — REQUIRED: server-side twin of VITE_DEPLOYMENT_MODE=selfhost (no plan checks)
#   DATAFORSEO_LOGIN      — https://dataforseo.com  (SERP, keywords, backlinks, audit)
#   DATAFORSEO_PASSWORD
#   OPENROUTER_API_KEY    — https://openrouter.ai/keys  (REQUIRED for AI visibility: ChatGPT, Perplexity, Gemini)
#   PEXELS_API_KEY        — optional stock images (never VITE_)
#   UNSPLASH_ACCESS_KEY   — optional fallback
#   MCP_API_TOKEN         — optional; 16+ chars if you run mcp-api (self-host only)

# ── Not needed in self-host (cloud only) ──────────────────────────────────────
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET — billing is disabled by VITE_DEPLOYMENT_MODE=selfhost.

# Optional: Google Search Console + GA4. The OAuth client ID from your own Google Cloud project;
# the matching GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET go in the edge-function secrets.
# VITE_GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com

# Optional: the support address the in-app Help page shows your users (hidden when unset).
# VITE_SUPPORT_EMAIL=support@yourdomain.com
